'use client';

import React, { Suspense, useState, useEffect, useRef } from 'react';
import { useRouter, useSearchParams } from 'next/navigation';
import Link from 'next/link';
import { useAuth } from '@/lib/contexts/AuthContext';
import { Button } from '@/components/ui/button';
import { motion, AnimatePresence } from 'framer-motion';
import { Loader2, Mail, Lock, User, Phone, FileText, Check, AlertCircle, ArrowRight, Eye, EyeOff, MapPin, Shield, Sparkles } from 'lucide-react';
import { auth } from '@/lib/firebase/config';
import { trackMarketingEvent } from '@/lib/analytics/client';
import { trackGA4SignUp } from '@/lib/analytics/ga4-tracking';
import { COUNTRIES, Country, detectUserCountry } from '@/lib/constants/countries';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';

// Validaciones mejoradas
const validateEmail = (email: string): boolean => {
  const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  return re.test(email.toLowerCase());
};

const validateName = (name: string): boolean => {
  return name.trim().length >= 2 && /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/.test(name);
};

const validatePhone = (phone: string): boolean => {
  const cleaned = phone.replace(/\D/g, '');
  return cleaned.length >= 7 && cleaned.length <= 15;
};

const validateDocument = (doc: string): boolean => {
  const cleaned = doc.replace(/[^0-9a-zA-Z-]/g, '');
  return cleaned.length >= 5;
};

const getPasswordRequirements = (password: string) => ({
  length: password.length >= 8,
  uppercase: /[A-Z]/.test(password),
  lowercase: /[a-z]/.test(password),
  special: /[0-9\W_]/.test(password),
});

const calculatePasswordStrength = (password: string): number => {
  const requirements = getPasswordRequirements(password);
  const score = Object.values(requirements).filter(Boolean).length;
  return (score / 4) * 100;
};

// Animaciones
const fieldVariants = {
  hidden: { opacity: 0, y: 20, scale: 0.95 },
  visible: {
    opacity: 1,
    y: 0,
    scale: 1,
    transition: {
      type: "spring",
      stiffness: 300,
      damping: 25
    }
  },
  exit: {
    opacity: 0,
    y: -20,
    scale: 0.95,
    transition: { duration: 0.2 }
  }
};

const checkVariants = {
  hidden: { scale: 0, rotate: -180 },
  visible: {
    scale: 1,
    rotate: 0,
    transition: {
      type: "spring",
      stiffness: 500,
      damping: 15
    }
  }
};

const shakeVariants = {
  shake: {
    x: [0, -10, 10, -10, 10, 0],
    transition: { duration: 0.4 }
  }
};

// Component that uses useSearchParams - wrapped in Suspense
function RegisterContent() {
  const router = useRouter();
  const searchParams = useSearchParams();
  const redirect = searchParams.get('redirect');
  const { signUpWithEmail, user } = useAuth();

  // Form state
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [firstName, setFirstName] = useState('');
  const [lastName, setLastName] = useState('');
  const [selectedCountry, setSelectedCountry] = useState<Country>(detectUserCountry());
  const [phone, setPhone] = useState('');
  const [documentType, setDocumentType] = useState<'dni' | 'passport' | 'rut'>('dni');
  const [documentNumber, setDocumentNumber] = useState('');

  // UI state
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');
  const [showPassword, setShowPassword] = useState(false);

  // Progressive disclosure state
  const [completedFields, setCompletedFields] = useState<Set<string>>(new Set());
  const [currentField, setCurrentField] = useState('firstName');

  // Field validation state
  const [fieldErrors, setFieldErrors] = useState<Record<string, string>>({});
  const [fieldValid, setFieldValid] = useState<Record<string, boolean>>({});

  // Refs for auto-focus
  const firstNameRef = useRef<HTMLInputElement>(null);
  const lastNameRef = useRef<HTMLInputElement>(null);
  const emailRef = useRef<HTMLInputElement>(null);
  const phoneRef = useRef<HTMLInputElement>(null);
  const documentRef = useRef<HTMLInputElement>(null);
  const passwordRef = useRef<HTMLInputElement>(null);

  // Redirect if already logged in
  useEffect(() => {
    if (user) {
      router.push(redirect || '/');
    }
  }, [user, router, redirect]);

  // Auto-focus first field on mount
  useEffect(() => {
    setTimeout(() => firstNameRef.current?.focus(), 100);
  }, []);

  // Progressive field unlocking
  useEffect(() => {
    const fields: Record<string, () => boolean> = {
      firstName: () => true, // Always available
      lastName: () => validateName(firstName),
      email: () => validateName(firstName) && validateName(lastName),
      country: () => validateName(firstName) && validateName(lastName) && validateEmail(email),
      phone: () => validateName(firstName) && validateName(lastName) && validateEmail(email) && !!selectedCountry,
      documentType: () => validateName(firstName) && validateName(lastName) && validateEmail(email) && validatePhone(phone),
      documentNumber: () => validateName(firstName) && validateName(lastName) && validateEmail(email) && validatePhone(phone) && !!documentType,
      password: () => validateName(firstName) && validateName(lastName) && validateEmail(email) && validatePhone(phone) && validateDocument(documentNumber),
    };

    // Check which fields should be available
    Object.entries(fields).forEach(([field, check]) => {
      if (check() && !completedFields.has(field)) {
        // Field just became available
        setCompletedFields(prev => new Set([...prev, field]));

        // Auto-focus the newly available field
        if (field === 'lastName' && lastNameRef.current) {
          setTimeout(() => lastNameRef.current?.focus(), 300);
        } else if (field === 'email' && emailRef.current) {
          setTimeout(() => emailRef.current?.focus(), 300);
        } else if (field === 'phone' && phoneRef.current) {
          setTimeout(() => phoneRef.current?.focus(), 300);
        } else if (field === 'documentNumber' && documentRef.current) {
          setTimeout(() => documentRef.current?.focus(), 300);
        } else if (field === 'password' && passwordRef.current) {
          setTimeout(() => passwordRef.current?.focus(), 300);
        }
      }
    });
  }, [firstName, lastName, email, selectedCountry, phone, documentType, documentNumber, completedFields]);

  // Real-time validation
  const validateField = (field: string, value: string) => {
    let isValid = false;
    let errorMsg = '';

    switch (field) {
      case 'firstName':
      case 'lastName':
        isValid = validateName(value);
        errorMsg = isValid ? '' : 'Mínimo 2 caracteres, solo letras';
        break;
      case 'email':
        isValid = validateEmail(value);
        errorMsg = isValid ? '' : 'Email inválido';
        break;
      case 'phone':
        isValid = validatePhone(value);
        errorMsg = isValid ? '' : 'Teléfono inválido (7-15 dígitos)';
        break;
      case 'documentNumber':
        isValid = validateDocument(value);
        errorMsg = isValid ? '' : 'Documento inválido (mínimo 5 caracteres)';
        break;
      case 'password':
        const reqs = getPasswordRequirements(value);
        isValid = Object.values(reqs).every(Boolean);
        errorMsg = isValid ? '' : 'La contraseña no cumple los requisitos';
        break;
    }

    setFieldValid(prev => ({ ...prev, [field]: isValid }));
    setFieldErrors(prev => ({ ...prev, [field]: errorMsg }));
  };

  // Handle country change
  const handleCountryChange = (countryCode: string) => {
    const country = COUNTRIES.find(c => c.code === countryCode);
    if (country) {
      setSelectedCountry(country);
    }
  };

  // Calculate progress
  const totalFields = 8;
  const filledFields = [
    firstName,
    lastName,
    email,
    selectedCountry,
    phone,
    documentType,
    documentNumber,
    password
  ].filter(Boolean).length;
  const progress = (filledFields / totalFields) * 100;

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError('');
    setLoading(true);

    try {
      // Final validation
      if (!validateName(firstName) || !validateName(lastName)) {
        throw new Error('Nombre o apellido inválido');
      }
      if (!validateEmail(email)) {
        throw new Error('Email inválido');
      }
      if (!validatePhone(phone)) {
        throw new Error('Teléfono inválido');
      }
      if (!validateDocument(documentNumber)) {
        throw new Error('Documento inválido');
      }

      const requirements = getPasswordRequirements(password);
      if (!Object.values(requirements).every(Boolean)) {
        throw new Error('La contraseña no cumple con los requisitos de seguridad');
      }

      await signUpWithEmail(email.trim().toLowerCase(), password, {
        firstName: firstName.trim(),
        lastName: lastName.trim(),
        phone: phone.replace(/\D/g, ''),
        phonePrefix: selectedCountry.prefix,
        documentType,
        documentNumber: documentNumber.trim(),
        country: selectedCountry.name,
      });

      // Track signup
      trackMarketingEvent('CompleteRegistration');
      trackGA4SignUp('email');

      // Redirect
      router.push(redirect || '/');
    } catch (err: any) {
      console.error('Registration error:', err);
      let errorMessage = 'Error al crear la cuenta. Intenta nuevamente.';

      if (err.code === 'auth/email-already-in-use') {
        errorMessage = 'Este email ya está registrado. Intenta iniciar sesión.';
      } else if (err.code === 'auth/weak-password') {
        errorMessage = 'La contraseña es demasiado débil. Debe tener al menos 8 caracteres.';
      } else if (err.code === 'auth/invalid-email') {
        errorMessage = 'El formato del email es inválido.';
      } else if (err.message) {
        errorMessage = err.message;
      }

      setError(errorMessage);
    } finally {
      setLoading(false);
    }
  };

  const passwordStrength = calculatePasswordStrength(password);
  const requirements = getPasswordRequirements(password);

  return (
    <div className="min-h-screen relative bg-[#141618] flex items-center justify-center p-4 overflow-hidden">
      {/* Background */}
      <div aria-hidden="true" className="pointer-events-none absolute inset-0 bg-[#141618]" />
      <div
        aria-hidden="true"
        className="pointer-events-none absolute inset-0 opacity-40"
        style={{
          backgroundImage:
            'radial-gradient(circle at 50% 0%, rgba(251,169,5,0.08), transparent 40%), radial-gradient(circle at 100% 100%, rgba(0,203,255,0.06), transparent 40%)'
        }}
      />

      <motion.div
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.5 }}
        className="relative z-10 w-full max-w-md"
      >
        {/* Progress Bar */}
        <div className="mb-6">
          <div className="flex items-center justify-between mb-2">
            <span className="text-white/60 text-sm font-medium">Progreso de registro</span>
            <span className="text-white/80 text-sm font-semibold">{Math.round(progress)}%</span>
          </div>
          <div className="h-2 bg-white/10 rounded-full overflow-hidden backdrop-blur-sm">
            <motion.div
              className="h-full bg-gradient-to-r from-primary via-yellow-500 to-green-500"
              initial={{ width: 0 }}
              animate={{ width: `${progress}%` }}
              transition={{ duration: 0.3, ease: "easeOut" }}
            />
          </div>
          <p className="text-white/40 text-xs mt-2">
            {filledFields} de {totalFields} campos completados
          </p>
        </div>

        {/* Card */}
        <div className="bg-white/5 backdrop-blur-xl rounded-2xl border border-white/10 shadow-2xl p-8">
          {/* Header */}
          <div className="text-center mb-8">
            <div className="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary/20 mb-4">
              <Sparkles className="w-8 h-8 text-primary" />
            </div>
            <h1 className="text-3xl font-bold text-white mb-2">Crear Cuenta</h1>
            <p className="text-white/60 text-sm">
              Únete a más de 10,000 fans de música electrónica
            </p>
          </div>

          {/* Error Message */}
          <AnimatePresence>
            {error && (
              <motion.div
                initial={{ opacity: 0, y: -10 }}
                animate={{ opacity: 1, y: 0 }}
                exit={{ opacity: 0, y: -10 }}
                className="mb-6 p-4 bg-red-500/10 border border-red-500/20 rounded-lg flex items-start gap-3"
              >
                <AlertCircle className="w-5 h-5 text-red-400 flex-shrink-0 mt-0.5" />
                <p className="text-red-200 text-sm">{error}</p>
              </motion.div>
            )}
          </AnimatePresence>

          {/* Form */}
          <form onSubmit={handleSubmit} className="space-y-4">
            {/* First Name - Always visible */}
            <motion.div
              initial={{ opacity: 0, y: 20, scale: 0.95 }}
              animate={{ opacity: 1, y: 0, scale: 1 }}
              transition={{ type: "spring", stiffness: 300, damping: 25 }}
              className="space-y-2"
            >
              <label htmlFor="firstName" className="text-white text-sm font-medium flex items-center gap-2">
                <User className="w-4 h-4 text-primary" />
                Nombre *
                {fieldValid.firstName && (
                  <motion.div
                    initial={{ scale: 0, rotate: -180 }}
                    animate={{ scale: 1, rotate: 0 }}
                    transition={{ type: "spring", stiffness: 500, damping: 15 }}
                  >
                    <Check className="w-4 h-4 text-green-400" />
                  </motion.div>
                )}
              </label>
              <input
                ref={firstNameRef}
                id="firstName"
                type="text"
                value={firstName}
                onChange={(e) => {
                  const value = e.target.value;
                  setFirstName(value);
                  if (value) validateField('firstName', value);
                }}
                onBlur={() => firstName && validateField('firstName', firstName)}
                className="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all"
                placeholder="Ej: Juan"
                autoComplete="given-name"
              />
              {fieldErrors.firstName && (
                <motion.p variants={shakeVariants} animate="shake" className="text-red-400 text-xs flex items-center gap-1">
                  <AlertCircle className="w-3 h-3" />
                  {fieldErrors.firstName}
                </motion.p>
              )}
            </motion.div>

            {/* Last Name */}
            <AnimatePresence>
              {completedFields.has('lastName') && (
                <motion.div
                  variants={fieldVariants}
                  initial="hidden"
                  animate="visible"
                  exit="exit"
                  className="space-y-2"
                >
                  <label htmlFor="lastName" className="text-white text-sm font-medium flex items-center gap-2">
                    <User className="w-4 h-4 text-primary" />
                    Apellidos *
                    {fieldValid.lastName && (
                      <motion.div variants={checkVariants} initial="hidden" animate="visible">
                        <Check className="w-4 h-4 text-green-400" />
                      </motion.div>
                    )}
                  </label>
                  <input
                    ref={lastNameRef}
                    id="lastName"
                    type="text"
                    value={lastName}
                    onChange={(e) => {
                      const value = e.target.value;
                      setLastName(value);
                      if (value) validateField('lastName', value);
                    }}
                    onBlur={() => lastName && validateField('lastName', lastName)}
                    className="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all"
                    placeholder="Ej: Pérez García"
                    autoComplete="family-name"
                  />
                  {fieldErrors.lastName && (
                    <motion.p variants={shakeVariants} animate="shake" className="text-red-400 text-xs flex items-center gap-1">
                      <AlertCircle className="w-3 h-3" />
                      {fieldErrors.lastName}
                    </motion.p>
                  )}
                </motion.div>
              )}
            </AnimatePresence>

            {/* Email */}
            <AnimatePresence>
              {completedFields.has('email') && (
                <motion.div
                  variants={fieldVariants}
                  initial="hidden"
                  animate="visible"
                  exit="exit"
                  className="space-y-2"
                >
                  <label htmlFor="email" className="text-white text-sm font-medium flex items-center gap-2">
                    <Mail className="w-4 h-4 text-primary" />
                    Email *
                    {fieldValid.email && (
                      <motion.div variants={checkVariants} initial="hidden" animate="visible">
                        <Check className="w-4 h-4 text-green-400" />
                      </motion.div>
                    )}
                  </label>
                  <input
                    ref={emailRef}
                    id="email"
                    type="email"
                    value={email}
                    onChange={(e) => {
                      const value = e.target.value.trim().toLowerCase();
                      setEmail(value);
                      if (value) validateField('email', value);
                    }}
                    onBlur={() => email && validateField('email', email)}
                    className="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all"
                    placeholder="tu@email.com"
                    autoComplete="email"
                    inputMode="email"
                  />
                  {fieldErrors.email && (
                    <motion.p variants={shakeVariants} animate="shake" className="text-red-400 text-xs flex items-center gap-1">
                      <AlertCircle className="w-3 h-3" />
                      {fieldErrors.email}
                    </motion.p>
                  )}
                </motion.div>
              )}
            </AnimatePresence>

            {/* Country Selector */}
            <AnimatePresence>
              {completedFields.has('country') && (
                <motion.div
                  variants={fieldVariants}
                  initial="hidden"
                  animate="visible"
                  exit="exit"
                  className="space-y-2"
                >
                  <label htmlFor="country" className="text-white text-sm font-medium flex items-center gap-2">
                    <MapPin className="w-4 h-4 text-primary" />
                    País *
                    {selectedCountry && (
                      <motion.div variants={checkVariants} initial="hidden" animate="visible">
                        <Check className="w-4 h-4 text-green-400" />
                      </motion.div>
                    )}
                  </label>
                  <Select value={selectedCountry.code} onValueChange={handleCountryChange}>
                    <SelectTrigger className="w-full bg-white/10 border-white/20 text-white hover:bg-white/20">
                      <SelectValue>
                        {selectedCountry && (
                          <span className="flex items-center gap-2">
                            <span className="text-xl">{selectedCountry.flag}</span>
                            {selectedCountry.name}
                            <span className="text-white/60 text-xs ml-auto">{selectedCountry.prefix}</span>
                          </span>
                        )}
                      </SelectValue>
                    </SelectTrigger>
                    <SelectContent className="bg-[#1A1D21] border-white/20 max-h-64">
                      {COUNTRIES.map((country) => (
                        <SelectItem
                          key={country.code}
                          value={country.code}
                          className="text-white hover:bg-white/10 cursor-pointer"
                        >
                          <span className="flex items-center gap-2">
                            <span className="text-xl">{country.flag}</span>
                            <span>{country.name}</span>
                            <span className="text-white/40 text-xs ml-auto">{country.prefix}</span>
                          </span>
                        </SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                  <p className="text-white/40 text-xs">
                    El prefijo telefónico se asignará automáticamente
                  </p>
                </motion.div>
              )}
            </AnimatePresence>

            {/* Phone */}
            <AnimatePresence>
              {completedFields.has('phone') && (
                <motion.div
                  variants={fieldVariants}
                  initial="hidden"
                  animate="visible"
                  exit="exit"
                  className="space-y-2"
                >
                  <label htmlFor="phone" className="text-white text-sm font-medium flex items-center gap-2">
                    <Phone className="w-4 h-4 text-primary" />
                    Teléfono *
                    {fieldValid.phone && (
                      <motion.div variants={checkVariants} initial="hidden" animate="visible">
                        <Check className="w-4 h-4 text-green-400" />
                      </motion.div>
                    )}
                  </label>
                  <div className="flex gap-2">
                    <div className="w-24 px-4 py-3 bg-white/5 border border-white/20 rounded-lg text-white flex items-center justify-center font-medium">
                      <span className="text-lg mr-1">{selectedCountry.flag}</span>
                      {selectedCountry.prefix}
                    </div>
                    <input
                      ref={phoneRef}
                      id="phone"
                      type="tel"
                      value={phone}
                      onChange={(e) => {
                        const value = e.target.value.replace(/\D/g, '');
                        setPhone(value);
                        if (value) validateField('phone', value);
                      }}
                      onBlur={() => phone && validateField('phone', phone)}
                      className="flex-1 px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all"
                      placeholder="912345678"
                      autoComplete="tel"
                      inputMode="tel"
                    />
                  </div>
                  {fieldErrors.phone && (
                    <motion.p variants={shakeVariants} animate="shake" className="text-red-400 text-xs flex items-center gap-1">
                      <AlertCircle className="w-3 h-3" />
                      {fieldErrors.phone}
                    </motion.p>
                  )}
                </motion.div>
              )}
            </AnimatePresence>

            {/* Document Type */}
            <AnimatePresence>
              {completedFields.has('documentType') && (
                <motion.div
                  variants={fieldVariants}
                  initial="hidden"
                  animate="visible"
                  exit="exit"
                  className="space-y-2"
                >
                  <label htmlFor="documentType" className="text-white text-sm font-medium flex items-center gap-2">
                    <FileText className="w-4 h-4 text-primary" />
                    Tipo de Documento *
                  </label>
                  <Select value={documentType} onValueChange={(value: any) => setDocumentType(value)}>
                    <SelectTrigger className="w-full bg-white/10 border-white/20 text-white">
                      <SelectValue />
                    </SelectTrigger>
                    <SelectContent className="bg-[#1A1D21] border-white/20">
                      <SelectItem value="dni" className="text-white hover:bg-white/10">DNI</SelectItem>
                      <SelectItem value="passport" className="text-white hover:bg-white/10">Pasaporte</SelectItem>
                      <SelectItem value="rut" className="text-white hover:bg-white/10">RUT</SelectItem>
                    </SelectContent>
                  </Select>
                </motion.div>
              )}
            </AnimatePresence>

            {/* Document Number */}
            <AnimatePresence>
              {completedFields.has('documentNumber') && (
                <motion.div
                  variants={fieldVariants}
                  initial="hidden"
                  animate="visible"
                  exit="exit"
                  className="space-y-2"
                >
                  <label htmlFor="documentNumber" className="text-white text-sm font-medium flex items-center gap-2">
                    <FileText className="w-4 h-4 text-primary" />
                    Número de Documento *
                    {fieldValid.documentNumber && (
                      <motion.div variants={checkVariants} initial="hidden" animate="visible">
                        <Check className="w-4 h-4 text-green-400" />
                      </motion.div>
                    )}
                  </label>
                  <input
                    ref={documentRef}
                    id="documentNumber"
                    type="text"
                    value={documentNumber}
                    onChange={(e) => {
                      const value = e.target.value;
                      setDocumentNumber(value);
                      if (value) validateField('documentNumber', value);
                    }}
                    onBlur={() => documentNumber && validateField('documentNumber', documentNumber)}
                    className="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all"
                    placeholder="Ej: 12345678"
                  />
                  {fieldErrors.documentNumber && (
                    <motion.p variants={shakeVariants} animate="shake" className="text-red-400 text-xs flex items-center gap-1">
                      <AlertCircle className="w-3 h-3" />
                      {fieldErrors.documentNumber}
                    </motion.p>
                  )}
                </motion.div>
              )}
            </AnimatePresence>

            {/* Password */}
            <AnimatePresence>
              {completedFields.has('password') && (
                <motion.div
                  variants={fieldVariants}
                  initial="hidden"
                  animate="visible"
                  exit="exit"
                  className="space-y-2"
                >
                  <label htmlFor="password" className="text-white text-sm font-medium flex items-center gap-2">
                    <Lock className="w-4 h-4 text-primary" />
                    Contraseña *
                    {fieldValid.password && (
                      <motion.div variants={checkVariants} initial="hidden" animate="visible">
                        <Check className="w-4 h-4 text-green-400" />
                      </motion.div>
                    )}
                  </label>
                  <div className="relative">
                    <input
                      ref={passwordRef}
                      id="password"
                      type={showPassword ? 'text' : 'password'}
                      value={password}
                      onChange={(e) => {
                        const value = e.target.value;
                        setPassword(value);
                        if (value) validateField('password', value);
                      }}
                      onBlur={() => password && validateField('password', password)}
                      className="w-full px-4 py-3 pr-12 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all"
                      placeholder="Mínimo 8 caracteres"
                      autoComplete="new-password"
                    />
                    <button
                      type="button"
                      onClick={() => setShowPassword(!showPassword)}
                      className="absolute right-3 top-1/2 -translate-y-1/2 text-white/60 hover:text-white transition-colors"
                    >
                      {showPassword ? <EyeOff className="w-5 h-5" /> : <Eye className="w-5 h-5" />}
                    </button>
                  </div>

                  {/* Password Strength */}
                  {password && (
                    <div className="space-y-2">
                      <div className="flex items-center justify-between">
                        <span className="text-white/60 text-xs">Fortaleza de la contraseña</span>
                        <span className={`text-xs font-medium ${
                          passwordStrength >= 75 ? 'text-green-400' :
                          passwordStrength >= 50 ? 'text-yellow-400' :
                          'text-red-400'
                        }`}>
                          {passwordStrength >= 75 ? 'Fuerte' : passwordStrength >= 50 ? 'Media' : 'Débil'}
                        </span>
                      </div>
                      <div className="h-2 bg-white/10 rounded-full overflow-hidden">
                        <motion.div
                          className={`h-full ${
                            passwordStrength >= 75 ? 'bg-green-500' :
                            passwordStrength >= 50 ? 'bg-yellow-500' :
                            'bg-red-500'
                          }`}
                          initial={{ width: 0 }}
                          animate={{ width: `${passwordStrength}%` }}
                          transition={{ duration: 0.3 }}
                        />
                      </div>

                      {/* Requirements */}
                      <div className="grid grid-cols-2 gap-2 text-xs">
                        <div className={`flex items-center gap-1 ${requirements.length ? 'text-green-400' : 'text-white/40'}`}>
                          {requirements.length ? <Check className="w-3 h-3" /> : <div className="w-3 h-3 rounded-full border border-current" />}
                          8+ caracteres
                        </div>
                        <div className={`flex items-center gap-1 ${requirements.uppercase ? 'text-green-400' : 'text-white/40'}`}>
                          {requirements.uppercase ? <Check className="w-3 h-3" /> : <div className="w-3 h-3 rounded-full border border-current" />}
                          Mayúscula
                        </div>
                        <div className={`flex items-center gap-1 ${requirements.lowercase ? 'text-green-400' : 'text-white/40'}`}>
                          {requirements.lowercase ? <Check className="w-3 h-3" /> : <div className="w-3 h-3 rounded-full border border-current" />}
                          Minúscula
                        </div>
                        <div className={`flex items-center gap-1 ${requirements.special ? 'text-green-400' : 'text-white/40'}`}>
                          {requirements.special ? <Check className="w-3 h-3" /> : <div className="w-3 h-3 rounded-full border border-current" />}
                          Número/Símbolo
                        </div>
                      </div>
                    </div>
                  )}
                </motion.div>
              )}
            </AnimatePresence>

            {/* Trust Signals */}
            {progress > 50 && (
              <motion.div
                initial={{ opacity: 0, y: 10 }}
                animate={{ opacity: 1, y: 0 }}
                className="flex items-center justify-center gap-2 text-white/40 text-xs pt-2"
              >
                <Shield className="w-4 h-4" />
                Tu información está protegida y encriptada
              </motion.div>
            )}

            {/* Submit Button */}
            <Button
              type="submit"
              disabled={loading || progress < 100}
              className="w-full bg-primary hover:bg-primary/90 text-black font-semibold py-6 rounded-lg transition-all transform hover:scale-[1.02] active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100"
            >
              {loading ? (
                <>
                  <Loader2 className="animate-spin h-5 w-5 mr-2" />
                  Creando cuenta...
                </>
              ) : (
                <>
                  Crear Cuenta
                  <ArrowRight className="ml-2 h-5 w-5" />
                </>
              )}
            </Button>
          </form>

          {/* Footer */}
          <div className="text-center pt-6">
            <p className="text-white/50 text-sm">
              ¿Ya tienes una cuenta?{' '}
              <Link href={`/login${redirect ? `?redirect=${encodeURIComponent(redirect)}` : ''}`} className="text-primary hover:text-primary/80 font-semibold hover:underline transition-colors">
                Inicia sesión aquí
              </Link>
            </p>
          </div>
        </div>
      </motion.div>
    </div>
  );
}

export default function RegisterPage() {
  return (
    <Suspense fallback={
      <div className="min-h-screen flex items-center justify-center bg-[#141618]">
        <Loader2 className="h-8 w-8 text-primary animate-spin" />
      </div>
    }>
      <RegisterContent />
    </Suspense>
  );
}
