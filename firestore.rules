rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Admins can read all users
    match /users/{userId} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    // Config collection - read only for authenticated users
    match /config/{configId} {
      allow read: if request.auth != null;
    }

    // Countries collection - read only for all users
    match /countries/{countryId} {
      allow read: if true;
    }

    // Events - read for all authenticated users, write for admins
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    // Event CTAs - same as events
    match /eventCTAs/{ctaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    // Event DJs - read for all, write for admins
    match /eventDjs/{djId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    // DJ suggestions - read for admins, write for authenticated users
    match /djSuggestions/{suggestionId} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
      allow write: if request.auth != null;
    }

    // DJs collection - read for all, write for admins
    match /djs/{djId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    // Blog collections - read for all, write for admins
    match /blog/{postId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    match /blogCategories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    match /blogTags/{tagId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    // Blog comments and reactions - read for all, write for authenticated users
    match /blogComments/{commentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /blogRatings/{ratingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /blogReactions/{reactionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /commentReactions/{reactionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Products and commerce - read for all, write for admins
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    match /productCategories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    match /productVariants/{variantId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    match /productReviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /storeBanners/{bannerId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    // Orders and transactions - users can read/write their own, admins can read all
    match /orders/{orderId} {
      allow read, write: if request.auth != null && request.auth.uid ==
        resource.data.userId;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    match /ticketTransactions/{transactionId} {
      // Users can read their own transactions
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;

      // Users can create their own transactions (checkout flow)
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.ticketDeliveryStatus == 'pending';

      // Users can only update proof-related fields on their own transactions
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId // Cannot change owner
        && request.resource.data.paymentStatus == resource.data.paymentStatus // Cannot approve self
        && request.resource.data.ticketDeliveryStatus == resource.data.ticketDeliveryStatus // Cannot deliver self
        && request.resource.data.totalAmount == resource.data.totalAmount // Cannot change amounts
        && (!('ticketsUploadedFiles' in request.resource.data) || request.resource.data.ticketsUploadedFiles == resource.data.ticketsUploadedFiles) // Cannot add ticket files
        && (!('ticketsFiles' in request.resource.data) || request.resource.data.ticketsFiles == resource.data.ticketsFiles);

      // Admins can read all transactions
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];

      // Admin writes go through Admin SDK only (no client-side admin writes)
    }

    match /paymentInstallments/{installmentId} {
      // Users can read installments for their own transactions
      allow read: if request.auth != null && request.auth.uid ==
        get(/databases/$(database)/documents/ticketTransactions/$(resource.data.transactionId)).data.userId;

      // ✅ ELIMINAR: allow create completamente
      // Las cuotas SOLO se crean vía Admin SDK (app/api/tickets/purchase/route.ts)

      // ✅ CAMBIO: Regla de update segura - solo permite actualizar userUploadedProofUrl y userUploadedAt
      // Todos los demás campos deben permanecer iguales
      allow update: if request.auth != null
        && request.auth.uid == get(/databases/$(database)/documents/ticketTransactions/$(resource.data.transactionId)).data.userId
        // Campos inmutables - deben ser idénticos
        && request.resource.data.transactionId == resource.data.transactionId
        && request.resource.data.installmentNumber == resource.data.installmentNumber
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.status == resource.data.status
        && request.resource.data.dueDate == resource.data.dueDate
        && request.resource.data.adminApproved == resource.data.adminApproved
        // Campos de auditoría - si existen, no pueden cambiar
        && (!('paidAt' in request.resource.data) || request.resource.data.paidAt == resource.data.paidAt)
        && (!('approvedAt' in request.resource.data) || request.resource.data.approvedAt == resource.data.approvedAt)
        && (!('approvedBy' in request.resource.data) || request.resource.data.approvedBy == resource.data.approvedBy)
        && (!('rejectedAt' in request.resource.data) || request.resource.data.rejectedAt == resource.data.rejectedAt)
        && (!('rejectedBy' in request.resource.data) || request.resource.data.rejectedBy == resource.data.rejectedBy)
        && (!('revertedAt' in request.resource.data) || request.resource.data.revertedAt == resource.data.revertedAt)
        && (!('revertedBy' in request.resource.data) || request.resource.data.revertedBy == resource.data.revertedBy)
        && (!('actualPaymentDate' in request.resource.data) || request.resource.data.actualPaymentDate == resource.data.actualPaymentDate)
        && (!('paymentProofUrl' in request.resource.data) || request.resource.data.paymentProofUrl == resource.data.paymentProofUrl)
        && (!('originalPhaseId' in request.resource.data) || request.resource.data.originalPhaseId == resource.data.originalPhaseId)
        && (!('currentPhaseId' in request.resource.data) || request.resource.data.currentPhaseId == resource.data.currentPhaseId)
        && (!('originalAmount' in request.resource.data) || request.resource.data.originalAmount == resource.data.originalAmount)
        && (!('priceAdjusted' in request.resource.data) || request.resource.data.priceAdjusted == resource.data.priceAdjusted)
        && (!('priceAdjustmentReason' in request.resource.data) || request.resource.data.priceAdjustmentReason == resource.data.priceAdjustmentReason)
        && (!('priceAdjustedAt' in request.resource.data) || request.resource.data.priceAdjustedAt == resource.data.priceAdjustedAt);

      // Admins can read all installments
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];

      // Admin writes go through Admin SDK only (bypasses these rules)
    }

    // Gallery collections - read for all, write for admins
    match /albums/{albumId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    match /galleryImages/{imageId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    // Communication collections
    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    match /newsletter_subscribers/{subscriberId} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
      allow write: if true; // Allow anonymous subscriptions
    }

    match /newsletter_fingerprints/{fingerprintId} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    // Slug redirects - read for all
    match /slugRedirects/{redirectId} {
      allow read: if true;
    }

    // Visitor profiles - read/write for admins only
    match /visitorProfiles/{profileId} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }
  }
}